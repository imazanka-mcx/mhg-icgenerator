rules_version = '2';

// MHG Inn Code registry — standalone corporate project.
//
// No client touches Firestore directly. Every read and write goes through the
// callables in functions/, which run on the Admin SDK and bypass these rules,
// and which check the mhgAdmin custom claim themselves.
//
// This is not belt-and-braces caution: the uniqueness guarantee (G8) is a
// transactional create on a document id, and a client able to write innCodes
// could break it. Closing the whole database is the honest expression of that.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
