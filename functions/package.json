{
  "name": "mhg-inn-code-functions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@mcx/inn-code=../src/index.ts --alias:@mcx/inn-code/firestore=../src/registry/firestore.ts --outfile=lib/index.js",
    "build": "npm run typecheck && npm run bundle",
    "serve": "npm run build && firebase emulators:start --only functions,firestore"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
